{
  "name": "mentormatch",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:github": "ng build --configuration=github-pages",
    "build:prod": "ng build --configuration production --base-href /",
    "postbuild:prod": "node scripts/create-nojekyll.js",
    "deploy": "npm run build:prod && npx angular-cli-ghpages --dir=dist/mentormatch --nojekyll",
    "deploy:docs": "npm run build:prod && rm -rf docs && cp -r dist/mentormatch docs && node scripts/create-nojekyll.js docs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.0",
    "@angular/common": "^15.2.0",
    "@angular/compiler": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.0",
    "@angular/platform-browser": "^15.2.0",
    "@angular/platform-browser-dynamic": "^15.2.0",
    "@angular/router": "^15.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.0",
    "@angular/cli": "^15.2.0",
    "@angular/compiler-cli": "^15.2.0",
    "@types/node": "^18.0.0",
    "angular-cli-ghpages": "^1.0.0",
    "typescript": "~4.9.4",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}

